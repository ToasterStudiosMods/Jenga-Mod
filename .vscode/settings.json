{
    // ── Java ──────────────────────────────────────────────────────────────────
    "java.configuration.updateBuildConfiguration": "automatic",

    // Tell the Java extension where Gradle lives so it can resolve the classpath
    // (including VS2 and Fabric API jars) automatically after running ./gradlew genSources).
    "java.import.gradle.enabled": true,
    "java.import.gradle.wrapper.enabled": true,

    // Source/output paths (Fabric Loom conventions)
    "java.project.sourcePaths": [
        "src/main/java",
        "src/main/resources"
    ],

    // ── Editor helpers ────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    // ── File associations ─────────────────────────────────────────────────────
    "files.associations": {
        "*.json5": "jsonc",
        "*.mcmeta": "json"
    },

    // ── Recommended extensions (install from Extensions sidebar) ─────────────
    // Extension Pack for Java  → vscjava.vscode-java-pack
    // Gradle for Java          → vscjava.vscode-gradle
    // Both give you IntelliSense, run configs, and Gradle task UI in VS Code.

    // ── Gradle tasks shown in the sidebar ────────────────────────────────────
    "gradle.nestedProjects": false
}
