    "main": [
      "com.ToasterStudios.jenga.JengaMod"
    ],
    "client": [
      "com.ToasterStudios.jenga.client.JengaModClient"
    ]
  },
  "mixins": [
    "jengamod.mixins.json"
  ],
  "depends": {
